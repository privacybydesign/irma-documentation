# MCP server for docs.yivi.app (mcp-server/). Build from the repository root:
#   docker build -f Dockerfile.mcp -t irma-documentation-mcp .
# The image contains the Markdown sources of the site, so it serves the same commit as the docs image.

FROM node:25-alpine AS deps
WORKDIR /app/mcp-server
COPY mcp-server/package.json mcp-server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:25-alpine
# Fonts for rendering SVG diagrams to PNG (get_image): the diagrams use Inter and a monospace font.
RUN apk add --no-cache font-inter font-dejavu
ENV NODE_ENV=production \
    DOCS_ROOT=/app/yivi-docs \
    PORT=8080
WORKDIR /app/mcp-server
COPY --from=deps /app/mcp-server/node_modules ./node_modules
COPY mcp-server/package.json ./
COPY mcp-server/src ./src
COPY yivi-docs/docs /app/yivi-docs/docs
COPY yivi-docs/edi-stelsel /app/yivi-docs/edi-stelsel
COPY yivi-docs/blog /app/yivi-docs/blog
COPY yivi-docs/src/data /app/yivi-docs/src/data
COPY yivi-docs/static/img /app/yivi-docs/static/img
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["node", "src/main.ts"]
