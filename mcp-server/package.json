{
  "name": "yivi-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets AI agents search and read the Yivi documentation, the Dutch EUDI Wallet certification pages and the Yivi blog.",
  "type": "module",
  "bin": {
    "yivi-docs-mcp": "src/main.ts"
  },
  "scripts": {
